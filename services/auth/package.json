{
  "name": "root",
  "version": "1.0.1",
  "private": true,
  "description": "root workspace",
  "author": "",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspace app run build",
    "lint": "yarn run lint:eslint && yarn run lint:markdown && yarn run lint:prettier",
    "lint:eslint": "eslint --ignore-path ./.gitignore --max-warnings 0 --ext .ts,.js .",
    "lint:eslint:fix": "eslint --ignore-path ./.gitignore --fix --ext .ts,.js .",
    "lint:fix": "yarn run lint:eslint:fix && yarn run lint:markdown:fix && yarn run lint:prettier:fix",
    "lint:markdown": "markdownlint --ignore-path ./.gitignore \"./**/*.md\"",
    "lint:markdown:fix": "markdownlint --ignore-path ./.gitignore --fix \"./**/*.md\"",
    "lint:prettier": "prettier --ignore-path ./.gitignore --check \"./**/*.{ts,js,json,yaml,yml,md}\"",
    "lint:prettier:fix": "prettier --ignore-path ./.gitignore --write \"./**/*.{ts,js,json,yaml,yml,md}\"",
    "migrate:up": "yarn workspace app run migrate:up",
    "migrate:down": "yarn workspace app run migrate:down",
    "migrate:create": "yarn workspace app run migrate:create",
    "docker:build": "docker build . -t aladiev/auth",
    "docker:push": "docker push aladiev/auth",
    "docker:build-and-push": "yarn docker:build && yarn docker:push",
    "start": "yarn workspace app run start",
    "start:dev": "yarn workspace app run start:dev",
    "start:prod": "yarn workspace app run start:prod",
    "test:unit": "yarn workspace app run test:unit"
  },
  "devDependencies": {
    "@automock/adapters.nestjs": "^2.1.0",
    "@automock/jest": "^2.1.0",
    "@byndyusoft/eslint-config": "2.6.0",
    "@commitlint/cli": "18.4.3",
    "@commitlint/config-conventional": "18.4.3",
    "eslint": "8.37.0",
    "husky": "8.0.3",
    "migrate-mongo": "^12.1.3",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.2",
    "@byndyusoft/sonar-coverage-reporter": "^1.0.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.4.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "@types/node": "18.17.19",
    "lint-staged": "15.2.0",
    "markdownlint-cli": "0.37.0",
    "prettier": "3.1.0",
    "jest": "^29.5.0",
    "jest-junit": "^16.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "eslint-config-prettier": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier-plugin-packagejson": "2.4.7"
  }
}
